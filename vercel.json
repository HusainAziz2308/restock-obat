{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/husain.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "rewrites": [
    {
        "src": "/src/(.*)", 
        "dest": "/src/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/husain.php"
    }
  ]
}
